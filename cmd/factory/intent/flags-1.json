{
  "service": "flags",
  "purpose": "Feature flags for the platform team: who owns each flag and whether it is on, so releases can be decoupled from deploys.",
  "owner": "phil",
  "resource": {
    "name": "flag",
    "plural": "flags",
    "key": "key",
    "fields": [
      {"name": "key", "type": "string", "required": true, "pattern": "^[a-z][a-z0-9-]*$", "why": "keys appear in code and URLs"},
      {"name": "owner", "type": "string", "required": true},
      {"name": "enabled", "type": "bool", "default": false},
      {"name": "description", "type": "string"}
    ]
  },
  "examples": [
    {"name": "create a flag", "request": {"method": "POST", "path": "/flags", "body": {"key": "new-checkout", "owner": "payments"}},
     "expect": {"status": 201, "body": {"key": "new-checkout", "owner": "payments", "enabled": false}}},
    {"name": "flags start off", "request": {"method": "GET", "path": "/flags/new-checkout"},
     "expect": {"status": 200, "body": {"enabled": false}}},
    {"name": "turn it on", "request": {"method": "PATCH", "path": "/flags/new-checkout", "body": {"enabled": true}},
     "expect": {"status": 200, "body": {"key": "new-checkout", "enabled": true}}},
    {"name": "every flag needs an owner", "request": {"method": "POST", "path": "/flags", "body": {"key": "orphan"}},
     "expect": {"status": 400, "body": {"error": "owner is required"}}},
    {"name": "keys are lowercase", "request": {"method": "POST", "path": "/flags", "body": {"key": "NewCheckout", "owner": "payments"}},
     "expect": {"status": 400}},
    {"name": "no duplicate keys", "request": {"method": "POST", "path": "/flags", "body": {"key": "new-checkout", "owner": "web"}},
     "expect": {"status": 409}},
    {"name": "list flags", "request": {"method": "GET", "path": "/flags"},
     "expect": {"status": 200, "body": [{"key": "new-checkout"}]}},
    {"name": "delete a flag", "request": {"method": "DELETE", "path": "/flags/new-checkout"},
     "expect": {"status": 204}},
    {"name": "deleted flags are gone", "request": {"method": "GET", "path": "/flags/new-checkout"},
     "expect": {"status": 404}}
  ]
}
