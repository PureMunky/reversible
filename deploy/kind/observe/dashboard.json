{
 "uid": "reversible",
 "title": "Software built from intent",
 "description": "The path from intent to production for whatever the factory is running: what's live, how it was built and reviewed, what production says about it, and what the model cost.",
 "tags": [
  "reversible"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "What's live",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Live version",
   "description": "The version serving production. Versions are named by the hash of the intent they were built from.",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "max by (version) (reversible_live_version == 1)",
     "legendFormat": "{{version}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "name",
    "colorMode": "none",
