  {
   "type": "timeseries",
   "title": "Requests/s by version",
   "description": "Production traffic, attributed to the version that served it. During a canary both versions serve the same data.",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (version, role) (rate(reversible_requests_total[30s]))",
     "legendFormat": "{{version}} ({{role}})"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Server error ratio by version",
   "description": "What the canary's guardrail judges: a candidate whose errors rise above the live version's is stopped and rewound.",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(sum by (version) (rate(reversible_requests_total{code=~\"5..\"}[1m])) / sum by (version) (rate(reversible_requests_total[1m]))) or (0 * sum by (version) (rate(reversible_requests_total[1m])))",
     "legendFormat": "{{version}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "p95 latency by version",
   "description": "",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, version) (rate(reversible_request_seconds_bucket[1m])))",
     "legendFormat": "{{version}}"
